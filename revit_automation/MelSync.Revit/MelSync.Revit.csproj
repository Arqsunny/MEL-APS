<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Design Automation for Revit AppBundle (Revit 2025 engine = .NET 8).
    Compiles against the locally installed Revit API (reference only, never shipped: Private=false).
    Override the install folder with:  dotnet build -p:RevitInstall="D:\Autodesk\Revit 2025"
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MelSync.Revit</RootNamespace>
    <AssemblyName>MelSync.Revit</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Built once per Revit release (tools/build-bundle.ps1): dotnet build -p:RevitYear=2026 -->
    <RevitYear Condition="'$(RevitYear)' == ''">2025</RevitYear>
    <RevitInstall Condition="'$(RevitInstall)' == ''">C:\Program Files\Autodesk\Revit $(RevitYear)</RevitInstall>
    <DaPackageVersion Condition="'$(RevitYear)' == '2026'">2026.0.0</DaPackageVersion>
    <DaPackageVersion Condition="'$(DaPackageVersion)' == ''">2025.0.1</DaPackageVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstall)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Autodesk.Forge.DesignAutomation.Revit" Version="$(DaPackageVersion)" ExcludeAssets="runtime" />
    <ProjectReference Include="..\MelSync.Core\MelSync.Core.csproj" />
  </ItemGroup>
</Project>
